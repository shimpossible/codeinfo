{
  "name": "codeinfo",
  "publisher": "shimpossible",
  "displayName": "Code Info",
  "description": "Display Coverage and Diagnostic information for code",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeinfo.displayCoverage",
        "title": "CodeInfo: Update Coverage Data"
      },
      {
        "command": "codeinfo.updateCoverage",
        "title": "CodeInfo: Execute Coverage Data task"
      },
      {
        "command": "codeinfo.displayDiagnostic",
        "title": "CodeInfo: Update Problem Data"
      },
      {
        "command": "codeinfo.coverage.disableScope",
        "title": "CodeInfo: Disable a Scope"
      }
    ],
    "configuration": [
      {
        "title": "CodeInfo",
        "properties": {
          "codeinfo.coverage.updateTask":{
            "type":"string",
            "default":"Update Code Coverage",
            "description": "Task to run to update Code Coverages"
          },
          "codeinfo.coverage.enable":{
             "type":"boolean",
             "default": "true",
             "description": "Show Code coverage in editor"
          },
          "codeinfo.coverage.fullDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(46,160,67,0.15)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.fullLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(46,160,67,0.15)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.coverage.partialDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(248, 200, 0, 0.20)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.partialLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(248, 200, 0, 0.20)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.coverage.noneDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(248, 81,73,0.15)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.noneLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(248, 81,73,0.15)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.diagnostic.paths": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Path to Diagnostc json file"
                },
                "baseDir": {
                  "type": "string",
                  "description": "Base directory for all files in json",
                  "default": "${workspaceFolder}"
                }
              }
            },
            "default": [
              {
                "baseDir": "${workspaceFolder}",
                "path": "diag.json"
              }
            ]
          },
          "codeinfo.coverage.paths": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Path to Coverage json file"
                },
                "baseDir": {
                  "type": "string",
                  "description": "Base directory for all files in json",
                  "default": "${workspaceFolder}"
                }
              }
            },
            "default": [
              {
                "baseDir": "${workspaceFolder}",
                "path": "coverage.json"
              }
            ]
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.8.50",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}