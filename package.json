{
  "name": "codeinfo",
  "publisher": "shimpossible",
  "displayName": "Code Info",
  "description": "Display Coverage and Diagnostic information for code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeinfo.displayCoverage",
        "title": "CodeInfo: Update Coverage Data"
      },
      {
        "command": "codeinfo.displayDiagnostic",
        "title": "CodeInfo: Update Problem Data"
      },
      {
        "command": "codeinfo.coverage.disableScope",
        "title": "CodeInfo: Disable a Scope"
      }
    ],
    "configuration": [
      {
        "title": "CodeInfo",
        "properties": {
          "codeinfo.coverage.fullDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(0, 255, 0, 0.4)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.fullLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(0, 255, 0, 0.4)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.coverage.partialDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(163, 149, 0, 0.4)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.partialLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(255, 235, 0, 0.2)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.coverage.noneDark": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(163, 0, 0, 0.4)",
            "description": "dark themed highlight for full code coverage"
          },
          "codeinfo.coverage.noneLight": {
            "type": "string",
            "scope": "resource",
            "default": "rgba(255, 0, 0, 0.2)",
            "description": "light themed highlight for full code coverage"
          },
          "codeinfo.diagnostic.paths": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Path to Diagnostc json file"
                },
                "baseDir": {
                  "type": "string",
                  "description": "Base directory for all files in json",
                  "default": "${workspaceFolder}"
                }
              }
            },
            "default": [
              {
                "path": "diag.json"
              }
            ]
          },
          "codeinfo.coverage.paths": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Path to Coverage json file"
                },
                "baseDir": {
                  "type": "string",
                  "description": "Base directory for all files in json",
                  "default": "${workspaceFolder}"
                }
              }
            },
            "default": [
              {
                "path": "coverage.json"
              }
            ]
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.8.50",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}